    Action centrar = () =>
    {
        fila.Location = new Point(
            Math.Max(0, (contenedor.ClientSize.Width - fila.Width) / 2), 5);
    };

    contenedor.Resize += (s, e) => centrar();
    contenedor.PerformLayout();
    centrar();

    return contenedor;
}
