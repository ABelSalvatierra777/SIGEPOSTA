        private GroupBox CrearGrupoCarpetas()
        {
            GroupBox grupo = new GroupBox
            {
                Text = "Configuración de carpetas",
                Dock = DockStyle.Fill,
                Padding = new Padding(16, 12, 16, 12),
                BackColor = TemaSIGEPOSTA.Blanco,
                Margin = new Padding(0, 0, 0, 12)
            };

            TableLayoutPanel rejilla = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 3,
                RowCount = 2,
                BackColor = TemaSIGEPOSTA.Blanco,
                Padding = new Padding(5)
            };

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.Absolute, 165));

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.Percent, 100));

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.Absolute, 180));

            rejilla.RowStyles.Add(
                new RowStyle(SizeType.Percent, 50));

            rejilla.RowStyles.Add(
                new RowStyle(SizeType.Percent, 50));

            txtCarpetaOrigen = NuevoCampoRuta();
            txtCarpetaRespaldos = NuevoCampoRuta();

            Button btnOrigen = NuevoBoton(
                "SELECCIONAR", TipoBoton.Primario);

            btnOrigen.Click += (s, e) => SeleccionarOrigen();

            Button btnDestino = NuevoBoton(
                "SELECCIONAR", TipoBoton.Primario);

            btnDestino.Click += (s, e) => SeleccionarDestino();

            AgregarFilaCarpeta(
                rejilla, "Carpeta de origen:",
                txtCarpetaOrigen, btnOrigen, 0);

            AgregarFilaCarpeta(
                rejilla, "Carpeta de respaldos:",
                txtCarpetaRespaldos, btnDestino, 1);

            grupo.Controls.Add(rejilla);

            return grupo;
        }

        private TextBox NuevoCampoRuta()
        {
            return new TextBox
            {
                ReadOnly = true,
                Dock = DockStyle.Fill,
                BackColor = TemaSIGEPOSTA.FondoCampo,
                ForeColor = TemaSIGEPOSTA.Texto,
                Font = TemaSIGEPOSTA.FuenteCampo,
                BorderStyle = BorderStyle.FixedSingle,
                Margin = new Padding(0, 7, 15, 7)
            };
        }

        private void AgregarFilaCarpeta(
            TableLayoutPanel rejilla,
            string texto,
            Control campo,
            Control boton,
            int fila)
        {
            Label etiqueta = new Label
            {
                Text = texto,
                AutoSize = true,
                Anchor = AnchorStyles.Left,
                ForeColor = TemaSIGEPOSTA.Texto,
                Font = TemaSIGEPOSTA.FuenteEtiqueta,
                Margin = new Padding(0, 0, 10, 0)
            };

            boton.Anchor = AnchorStyles.Left;
            boton.Margin = new Padding(0, 5, 0, 5);

            rejilla.Controls.Add(etiqueta, 0, fila);
            rejilla.Controls.Add(campo, 1, fila);
            rejilla.Controls.Add(boton, 2, fila);
        }

        private Control CrearBotonera()
        {
            Panel contenedor = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = TemaSIGEPOSTA.Fondo
            };

            FlowLayoutPanel fila = new FlowLayoutPanel
            {
                AutoSize = true,
                AutoSizeMode = AutoSizeMode.GrowAndShrink,
                FlowDirection = FlowDirection.LeftToRight,
                WrapContents = false,
                BackColor = TemaSIGEPOSTA.Fondo,
                Padding = new Padding(0, 8, 0, 0)
            };

            Button btnCrear = NuevoBoton(
                "CREAR RESPALDO", TipoBoton.Primario);

            btnCrear.Click += (s, e) => CrearRespaldo();

            Button btnListar = NuevoBoton(
                "ACTUALIZAR LISTA", TipoBoton.Primario);

            btnListar.Click += (s, e) => ListarRespaldos();

            Button btnRestaurar = NuevoBoton(
                "RESTAURAR", TipoBoton.Peligro);

            btnRestaurar.Click += (s, e) => RestaurarRespaldo();

            fila.Controls.Add(btnCrear);
            fila.Controls.Add(btnListar);
            fila.Controls.Add(btnRestaurar);

            contenedor.Controls.Add(fila);

            Action centrar = () =>
            {
                fila.Left = Math.Max(
                    0, (contenedor.ClientSize.Width - fila.Width) / 2);

                fila.Top = 0;
            };

            contenedor.Resize += (s, e) => centrar();
            fila.SizeChanged += (s, e) => centrar();

            centrar();

            return contenedor;
        }

        private GroupBox CrearGrupoTabla()
        {
            GroupBox grupo = new GroupBox
            {
                Text = "Respaldos disponibles",
                Dock = DockStyle.Fill,
                Padding = new Padding(12),
                BackColor = TemaSIGEPOSTA.Blanco,
                Margin = new Padding(0, 0, 0, 10)
            };

            dgvRespaldos = new DataGridView
            {
                Dock = DockStyle.Fill,
                ReadOnly = true,
                AllowUserToAddRows = false,
                AllowUserToDeleteRows = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                BackgroundColor = TemaSIGEPOSTA.Blanco,
                RowHeadersVisible = false,
                AutoGenerateColumns = true,
                BorderStyle = BorderStyle.None,
                Margin = new Padding(5)
            };

            grupo.Controls.Add(dgvRespaldos);

            return grupo;
        }

        private Button NuevoBoton(string texto, TipoBoton tipo)
        {
            Button boton = new Button
            {
                Text = texto,
                Margin = new Padding(8, 5, 8, 5)
            };

            TemaSIGEPOSTA.EstilizarBoton(boton, tipo);

            return boton;
        }

        private void AplicarEstilos()
        {
            BackColor = TemaSIGEPOSTA.Fondo;
            Font = TemaSIGEPOSTA.Fuente;

            AplicarEstilosRecursivos(this);

            TemaSIGEPOSTA.EstilizarTabla(dgvRespaldos);
        }

        private void AplicarEstilosRecursivos(Control control)
        {
            if (control is GroupBox grupo)
            {
                TemaSIGEPOSTA.EstilizarGrupo(grupo);
            }
            else if (control is TextBox caja)
            {
                TemaSIGEPOSTA.EstilizarTextBox(caja);
                caja.ReadOnly = true;
            }
            else if (control is Label etiqueta)
            {
                TemaSIGEPOSTA.EstilizarEtiqueta(etiqueta);
            }

            foreach (Control hijo in control.Controls)
            {
                AplicarEstilosRecursivos(hijo);
            }
        }

        private void SeleccionarOrigen()
        {
            using FolderBrowserDialog dialogo = new FolderBrowserDialog
            {
                Description = "Seleccione la carpeta que desea respaldar"
            };

            if (dialogo.ShowDialog() == DialogResult.OK)
                txtCarpetaOrigen.Text = dialogo.SelectedPath;
        }

        private void SeleccionarDestino()
        {
            using FolderBrowserDialog dialogo = new FolderBrowserDialog
            {
                Description = "Seleccione la carpeta donde se guardarán los respaldos"
            };

            if (dialogo.ShowDialog() == DialogResult.OK)
            {
                txtCarpetaRespaldos.Text = dialogo.SelectedPath;
                ListarRespaldos();
            }
        }

        private void CrearRespaldo()
        {
            string origen = txtCarpetaOrigen.Text;
            string destino = txtCarpetaRespaldos.Text;

            if (!Directory.Exists(origen))
            {
                MessageBox.Show("Seleccione una carpeta de origen válida.");
                return;
            }

            if (string.IsNullOrWhiteSpace(destino))
            {
                MessageBox.Show("Seleccione la carpeta de respaldos.");
                return;
            }

            string rutaOrigen = Path.GetFullPath(origen)
                .TrimEnd(Path.DirectorySeparatorChar) +
                Path.DirectorySeparatorChar;

            string rutaDestino = Path.GetFullPath(destino)
                .TrimEnd(Path.DirectorySeparatorChar) +
                Path.DirectorySeparatorChar;

            if (rutaDestino.StartsWith(
                rutaOrigen,
                StringComparison.OrdinalIgnoreCase))
            {
                MessageBox.Show(
                    "La carpeta de respaldos no puede estar dentro de la carpeta de origen."
                );
                return;
            }

            try
            {
                Directory.CreateDirectory(destino);

                string nombre = "SIGEPOSTA_Respaldo_" +
                                DateTime.Now.ToString("yyyyMMdd_HHmmss") +
                                ".zip";

                string archivo = Path.Combine(destino, nombre);

                ZipFile.CreateFromDirectory(
                    origen,
                    archivo,
                    CompressionLevel.Optimal,
                    false
                );

                lblEstado.Text = "Estado: respaldo creado correctamente.";

                MessageBox.Show(
                    "Copia de seguridad creada correctamente.\n\n" +
                    archivo
                );

                ListarRespaldos();
            }
            catch (Exception ex)
            {
                lblEstado.Text = "Estado: error al crear el respaldo.";

                MessageBox.Show(
                    "No se pudo crear el respaldo:\n" + ex.Message
                );
            }
        }

        private void ListarRespaldos()
        {
            string carpeta = txtCarpetaRespaldos.Text;

            if (!Directory.Exists(carpeta))
            {
                dgvRespaldos.DataSource = null;
                return;
            }

            var archivos = Directory.GetFiles(carpeta, "*.zip")
                .Select(ruta => new
                {
                    Nombre = Path.GetFileName(ruta),
                    Ubicacion = ruta,
                    Fecha = File.GetLastWriteTime(ruta),
                    Tamano = Math.Round(
                        new FileInfo(ruta).Length / 1024.0,
                        2
                    ) + " KB"
                })
                .OrderByDescending(a => a.Fecha)
                .ToList();

            dgvRespaldos.DataSource = archivos;

            lblEstado.Text = "Estado: " + archivos.Count +
                             " respaldo(s) encontrado(s).";
        }

        private void RestaurarRespaldo()
        {
            if (dgvRespaldos.CurrentRow == null)
            {
                MessageBox.Show("Seleccione un respaldo de la lista.");
                return;
            }

            string archivo = dgvRespaldos.CurrentRow
                .Cells["Ubicacion"].Value?.ToString() ?? "";

            if (!File.Exists(archivo))
            {
                MessageBox.Show("El archivo seleccionado no existe.");
                return;
            }

            using FolderBrowserDialog dialogo = new FolderBrowserDialog
            {
                Description = "Seleccione la carpeta donde se restaurarán los archivos"
            };

            if (dialogo.ShowDialog() != DialogResult.OK)
                return;

            DialogResult respuesta = MessageBox.Show(
                "La restauración puede sobrescribir archivos existentes.\n" +
                "Se recomienda crear un respaldo de la carpeta de destino antes de continuar.\n\n" +
                "¿Desea continuar?",
                "Confirmar restauración",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning
            );

            if (respuesta != DialogResult.Yes)
                return;

            try
            {
                ZipFile.ExtractToDirectory(
                    archivo,
                    dialogo.SelectedPath,
                    true
                );

                lblEstado.Text = "Estado: restauración completada.";

                MessageBox.Show("Respaldo restaurado correctamente.");
            }
            catch (Exception ex)
            {
                lblEstado.Text = "Estado: error al restaurar.";

                MessageBox.Show(
                    "No se pudo restaurar el respaldo:\n" + ex.Message
                );
            }
        }
    }
}
