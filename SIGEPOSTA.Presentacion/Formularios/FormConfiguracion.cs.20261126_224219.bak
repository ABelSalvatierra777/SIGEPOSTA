
using System;
using System.Drawing;
using System.Windows.Forms;
using SIGEPOSTA.Presentacion.Estilos;

namespace SIGEPOSTA.Presentacion.Formularios
{
    public class FormConfiguracion : Form
    {
        private TextBox txtNombre = new();
        private TextBox txtCodigo = new();
        private TextBox txtDireccion = new();
        private TextBox txtTelefono = new();
        private TextBox txtCorreo = new();
        private TextBox txtResponsable = new();

        private ComboBox cmbCategoria = new();
        private Label lblEstado = new();

        public FormConfiguracion()
        {
            ConstruirFormulario();
            AplicarEstilos();
        }

        // ═══════════════════════ INTERFAZ ═══════════════════════

        private void ConstruirFormulario()
        {
            Text = "SIGEPOSTA - Configuración institucional";
            Size = new Size(1150, 780);
            MinimumSize = new Size(950, 680);
            StartPosition = FormStartPosition.CenterParent;
            BackColor = TemaSIGEPOSTA.Fondo;
            Font = TemaSIGEPOSTA.Fuente;

            // ENCABEZADO
            Panel encabezado = new Panel
            {
                Dock = DockStyle.Top,
                Height = 96,
                BackColor = TemaSIGEPOSTA.VerdeOscuro
            };

            encabezado.Controls.Add(new Label
            {
                Text = "CONFIGURACIÓN INSTITUCIONAL",
                ForeColor = Color.White,
                BackColor = Color.Transparent,
                Font = new Font("Segoe UI", 19, FontStyle.Bold),
                Location = new Point(32, 16),
                AutoSize = true
            });

            encabezado.Controls.Add(new Label
            {
                Text = "Administración de la información general del establecimiento de salud",
                ForeColor = Color.FromArgb(200, 225, 210),
                BackColor = Color.Transparent,
                Font = new Font("Segoe UI", 10),
                Location = new Point(35, 58),
                AutoSize = true
            });

            // CUERPO
            Panel cuerpo = new Panel
            {
                Dock = DockStyle.Fill,
                AutoScroll = true,
                Padding = new Padding(28, 24, 28, 20),
                BackColor = TemaSIGEPOSTA.Fondo
            };

            TableLayoutPanel columna = new TableLayoutPanel
            {
                Dock = DockStyle.Top,
                AutoSize = true,
                ColumnCount = 1,
                BackColor = TemaSIGEPOSTA.Fondo
            };

            columna.ColumnStyles.Add(
                new ColumnStyle(SizeType.Percent, 100));

            columna.Controls.Add(CrearGrupoDatos());
            columna.Controls.Add(CrearBotonera());

            cuerpo.Controls.Add(columna);

            Controls.Add(cuerpo);
            Controls.Add(encabezado);
        }

        // ═══════════════════════ GRUPO DE INFORMACIÓN ═══════════════════════

        private GroupBox CrearGrupoDatos()
        {
            GroupBox grupo = CrearGrupo(
                "Datos del establecimiento de salud", 390);

            TableLayoutPanel rejilla = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 4,
                RowCount = 4,
                BackColor = TemaSIGEPOSTA.Blanco,
                Padding = new Padding(5)
            };

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.AutoSize));

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.Percent, 60));

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.AutoSize));

            rejilla.ColumnStyles.Add(
                new ColumnStyle(SizeType.Percent, 40));

            for (int i = 0; i < 4; i++)
            {
                rejilla.RowStyles.Add(
                    new RowStyle(SizeType.Absolute, 65));
            }

            // CAMPOS
            txtNombre = NuevoCampo();
            txtNombre.Text = "Posta de Salud de Mollepata";

            txtCodigo = NuevoCampo();
            txtDireccion = NuevoCampo();
            txtTelefono = NuevoCampo();
            txtCorreo = NuevoCampo();
            txtResponsable = NuevoCampo();

            cmbCategoria = new ComboBox
            {
                DropDownStyle = ComboBoxStyle.DropDownList
            };

            cmbCategoria.Items.AddRange(new object[]
            {
                "I-1",
                "I-2",
                "I-3",
                "I-4"
            });

            cmbCategoria.SelectedIndex = 0;

            // FILA 1
            AgregarPar(rejilla, "Nombre:", txtNombre, 0, 0);
            AgregarPar(rejilla, "Código:", txtCodigo, 2, 0);

            // FILA 2
            AgregarPar(rejilla, "Dirección:", txtDireccion, 0, 1);
            AgregarPar(rejilla, "Teléfono:", txtTelefono, 2, 1);

            // FILA 3
            AgregarPar(rejilla, "Correo institucional:", txtCorreo, 0, 2);
            AgregarPar(rejilla, "Responsable:", txtResponsable, 2, 2);

            // FILA 4
            AgregarPar(rejilla, "Categoría:", cmbCategoria, 0, 3);

            grupo.Controls.Add(rejilla);

            return grupo;
        }

        // ═══════════════════════ BOTONERA ═══════════════════════

        private Control CrearBotonera()
        {
            FlowLayoutPanel fila = new FlowLayoutPanel
            {
                Dock = DockStyle.Top,
                Height = 65,
                FlowDirection = FlowDirection.LeftToRight,
                WrapContents = false,
                BackColor = TemaSIGEPOSTA.Fondo,
                Padding = new Padding(0, 10, 0, 0),
                Margin = new Padding(0, 0, 0, 14)
            };

            Button btnGuardar = NuevoBoton(
                "GUARDAR CONFIGURACIÓN", TipoBoton.Primario);

            btnGuardar.Width = 220;
            btnGuardar.Click += (s, e) => GuardarConfiguracion();

            Button btnLimpiar = NuevoBoton(
                "LIMPIAR", TipoBoton.Secundario);

            btnLimpiar.Click += (s, e) => LimpiarCampos();

            fila.Controls.Add(btnGuardar);
            fila.Controls.Add(btnLimpiar);

            lblEstado = new Label
            {
                Text = "Configuración pendiente de guardar.",
                AutoSize = true,
                ForeColor = TemaSIGEPOSTA.TextoSecundario,
                Font = TemaSIGEPOSTA.Fuente,
                Margin = new Padding(12, 10, 0, 0)
            };

            fila.Controls.Add(lblEstado);

            return fila;
        }

        // ═══════════════════════ AYUDAS DE DISEÑO ═══════════════════════

        private GroupBox CrearGrupo(string titulo, int alto)
        {
            return new GroupBox
            {
                Text = titulo,
                Dock = DockStyle.Top,
                Height = alto,
                Margin = new Padding(0, 0, 0, 14),
                Padding = new Padding(16, 10, 16, 10)
            };
        }

        private void AgregarPar(
            TableLayoutPanel rejilla,
            string texto,
            Control campo,
            int columna,
            int fila)
        {
            Label etiqueta = new Label
            {
                Text = texto,
                AutoSize = true,
                Anchor = AnchorStyles.Left,
                Margin = new Padding(0, 0, 10, 0),
                ForeColor = TemaSIGEPOSTA.Texto,
                Font = TemaSIGEPOSTA.FuenteEtiqueta
            };

            campo.Dock = DockStyle.Fill;
            campo.Margin = new Padding(0, 8, 24, 8);

            rejilla.Controls.Add(etiqueta, columna, fila);
            rejilla.Controls.Add(campo, columna + 1, fila);
        }

        private TextBox NuevoCampo()
        {
            return new TextBox();
        }

        private Button NuevoBoton(string texto, TipoBoton tipo)
        {
            Button boton = new Button
            {
                Text = texto,
                Margin = new Padding(0, 0, 12, 0)
            };

            TemaSIGEPOSTA.EstilizarBoton(boton, tipo);

            return boton;
        }

        // ═══════════════════════ ESTILOS ═══════════════════════

        private void AplicarEstilos()
        {
            foreach (GroupBox grupo in TodosLosControles<GroupBox>(this))
            {
                grupo.Font = TemaSIGEPOSTA.FuenteNegrita;
                grupo.ForeColor = TemaSIGEPOSTA.VerdeOscuro;
                grupo.BackColor = TemaSIGEPOSTA.Blanco;
            }

            foreach (TextBox caja in TodosLosControles<TextBox>(this))
                TemaSIGEPOSTA.EstilizarTextBox(caja);

            TemaSIGEPOSTA.EstilizarComboBox(cmbCategoria);
        }

        private static System.Collections.Generic.IEnumerable<T>
            TodosLosControles<T>(Control raiz) where T : Control
        {
            foreach (Control control in raiz.Controls)
            {
                if (control is T tipado)
                    yield return tipado;

                foreach (T hijo in TodosLosControles<T>(control))
                    yield return hijo;
            }
        }

        // ═══════════════════════ LÓGICA ═══════════════════════

        private void GuardarConfiguracion()
        {
            if (string.IsNullOrWhiteSpace(txtNombre.Text) ||
                string.IsNullOrWhiteSpace(txtDireccion.Text))
            {
                MessageBox.Show(
                    "Ingrese como mínimo el nombre y la dirección.",
                    "Validación",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                return;
            }

            MessageBox.Show(
                "Los datos fueron validados. Su almacenamiento permanente se implementará al conectar SQL Server.",
                "SIGEPOSTA",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information
            );

            lblEstado.Text =
                "Datos validados; pendientes de conexión con SQL Server.";
        }

        private void LimpiarCampos()
        {
            txtCodigo.Clear();
            txtDireccion.Clear();
            txtTelefono.Clear();
            txtCorreo.Clear();
            txtResponsable.Clear();

            cmbCategoria.SelectedIndex = 0;

            lblEstado.Text = "Formulario limpiado.";
        }
    }
}
