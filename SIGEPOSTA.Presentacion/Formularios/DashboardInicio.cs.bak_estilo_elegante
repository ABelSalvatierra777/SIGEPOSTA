        return fila;
    }

    private void CargarCitas(SqlConnection conexion)
    {
        using var adaptador = new SqlDataAdapter(@"
            SELECT TOP 8
                CONVERT(varchar(10), c.FechaCita, 103) AS Fecha,
                LEFT(CONVERT(varchar(8), c.HoraCita, 108), 5) AS Hora,
                CONCAT(p.Nombres, ' ', p.Apellidos) AS Paciente,
                CONCAT(ps.Nombres, ' ', ps.Apellidos) AS Profesional,
                c.Estado
            FROM Citas c
            INNER JOIN Pacientes p ON p.IdPaciente = c.IdPaciente
            INNER JOIN PersonalSalud ps ON ps.IdPersonalSalud = c.IdPersonalSalud
            WHERE c.FechaCita >= CAST(GETDATE() AS date)
            ORDER BY c.FechaCita, c.HoraCita;
        ", conexion);

        var tabla = new DataTable();
        adaptador.Fill(tabla);
        tablaCitas.DataSource = tabla;

        if (tablaCitas.Columns.Contains("Fecha"))
            tablaCitas.Columns["Fecha"]!.FillWeight = 70;

        if (tablaCitas.Columns.Contains("Hora"))
            tablaCitas.Columns["Hora"]!.FillWeight = 45;

        if (tablaCitas.Columns.Contains("Estado"))
            tablaCitas.Columns["Estado"]!.FillWeight = 70;
    }

    private void CargarActividad(SqlConnection conexion)
    {
        using var adaptador = new SqlDataAdapter(@"
            SELECT TOP 8
                CONVERT(varchar(16), FechaAccion, 103) + ' ' +
                LEFT(CONVERT(varchar(8), FechaAccion, 108), 5) AS Fecha,
                Modulo,
                Accion,
                Resultado
            FROM Auditoria
            ORDER BY FechaAccion DESC;
        ", conexion);

        var tabla = new DataTable();
        adaptador.Fill(tabla);
        tablaActividad.DataSource = tabla;

        if (tablaActividad.Columns.Contains("Fecha"))
            tablaActividad.Columns["Fecha"]!.FillWeight = 95;
    }

