    private void ConfigurarTabla(DataGridView tabla, string mensajeVacio)
    {
        tabla.ReadOnly = true;
        tabla.AllowUserToAddRows = false;
        tabla.AllowUserToDeleteRows = false;
        tabla.AllowUserToResizeRows = false;
        tabla.RowHeadersVisible = false;
        tabla.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
        tabla.SelectionMode = DataGridViewSelectionMode.FullRowSelect;
        tabla.MultiSelect = false;
        tabla.BackgroundColor = Color.White;
        tabla.BorderStyle = BorderStyle.None;
        tabla.CellBorderStyle = DataGridViewCellBorderStyle.SingleHorizontal;
        tabla.ColumnHeadersBorderStyle = DataGridViewHeaderBorderStyle.None;
        tabla.EnableHeadersVisualStyles = false;
        tabla.ColumnHeadersHeightSizeMode =
            DataGridViewColumnHeadersHeightSizeMode.DisableResizing;
        tabla.ColumnHeadersHeight = 36;
        tabla.RowTemplate.Height = 34;
        tabla.GridColor = TemaSIGEPOSTA.Borde;

        tabla.ColumnHeadersDefaultCellStyle.BackColor = verdeOscuro;
        tabla.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;
        tabla.ColumnHeadersDefaultCellStyle.Font = TemaSIGEPOSTA.FuenteEtiqueta;
        tabla.ColumnHeadersDefaultCellStyle.SelectionBackColor = verdeOscuro;
        tabla.ColumnHeadersDefaultCellStyle.SelectionForeColor = Color.White;
        tabla.ColumnHeadersDefaultCellStyle.Padding = new Padding(8, 0, 0, 0);

        tabla.DefaultCellStyle.Font = TemaSIGEPOSTA.Fuente;
        tabla.DefaultCellStyle.ForeColor = texto;
        tabla.DefaultCellStyle.BackColor = Color.White;
        tabla.DefaultCellStyle.Padding = new Padding(8, 0, 0, 0);
        tabla.DefaultCellStyle.SelectionBackColor = verdeClaro;
        tabla.DefaultCellStyle.SelectionForeColor = verdeOscuro;

        tabla.AlternatingRowsDefaultCellStyle.BackColor =
            Color.FromArgb(248, 250, 248);

        tabla.Dock = DockStyle.Fill;
        tabla.CellFormatting += Tabla_CellFormatting;

        tabla.Paint += (s, e) =>
        {
            if (tabla.RowCount > 0)
                return;

            e.Graphics.TextRenderingHint = TextRenderingHint.ClearTypeGridFit;

            Rectangle zona = new Rectangle(
                0, tabla.ColumnHeadersHeight,
                tabla.Width,
                Math.Max(10, tabla.Height - tabla.ColumnHeadersHeight));

            using var fuenteVacia = new Font("Segoe UI", 9.5F);

            TextRenderer.DrawText(
                e.Graphics,
                mensajeVacio,
                fuenteVacia,
                zona,
                secundario,
                TextFormatFlags.HorizontalCenter |
                TextFormatFlags.VerticalCenter);
        };
    }

    private void Tabla_CellFormatting(
        object? sender, DataGridViewCellFormattingEventArgs e)
    {
        if (sender is not DataGridView tabla ||
            e.RowIndex < 0 || e.Value == null)
            return;

        string columna = tabla.Columns[e.ColumnIndex].Name;

        if (columna != "Estado" && columna != "Resultado")
            return;

        string valor = (Convert.ToString(e.Value) ?? "").ToLowerInvariant();

        Color color = secundario;

        if (valor.Contains("cancel") || valor.Contains("anul") ||
            valor.Contains("error") || valor.Contains("fall") ||
            valor.Contains("rechaz"))
            color = rojo;
        else if (valor.Contains("exito") || valor.Contains("éxito") ||
                 valor.Contains("complet") || valor.Contains("aten") ||
                 valor.Contains("realiz") || valor.Contains("correct"))
            color = verde;
        else if (valor.Contains("pend") || valor.Contains("program") ||
                 valor.Contains("confirm") || valor.Contains("reserv"))
            color = azul;

        e.CellStyle.ForeColor = color;
        e.CellStyle.Font = fuenteEstado;
        e.CellStyle.SelectionForeColor = color;
    }

    // ═══════════════════════ DATOS ═══════════════════════
    private void CargarDatos()
    {
        try
        {
            using var conexion = ConexionBD.CrearConexion();
            conexion.Open();

            using (var comando = new SqlCommand(@"
                SELECT
                    (SELECT COUNT(*) FROM Pacientes WHERE Estado = 1) AS Pacientes,
                    (SELECT COUNT(*) FROM Citas
                     WHERE FechaCita = CAST(GETDATE() AS date)) AS CitasHoy,
                    (SELECT COUNT(*) FROM Atenciones
                     WHERE Estado = 1
                       AND FechaAtencion >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)
                       AND FechaAtencion < DATEADD(MONTH, 1,
                           DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))) AS AtencionesMes,
                    (SELECT COUNT(*)
                     FROM Inventario i
                     INNER JOIN Medicamentos m ON m.IdMedicamento = i.IdMedicamento
                     WHERE m.Estado = 1
                       AND (i.StockActual <= i.StockMinimo
                         OR i.FechaVencimiento <= DATEADD(DAY, 30, CAST(GETDATE() AS date)))) AS Alertas;
            ", conexion))
            using (var lector = comando.ExecuteReader())
            {
                if (lector.Read())
                {
                    lblPacientes.Text = Convert.ToInt32(lector["Pacientes"]).ToString("N0");
                    lblCitas.Text = Convert.ToInt32(lector["CitasHoy"]).ToString("N0");
                    lblAtenciones.Text = Convert.ToInt32(lector["AtencionesMes"]).ToString("N0");
                    lblAlertas.Text = Convert.ToInt32(lector["Alertas"]).ToString("N0");
                }
            }

            CargarGrafico(conexion);
            CargarAlertas(conexion);
            CargarCitas(conexion);
            CargarActividad(conexion);

            lblEstado.ForeColor = secundario;
            lblEstado.Text = "Datos actualizados: " +
                DateTime.Now.ToString("dd/MM/yyyy HH:mm");
        }
        catch (Exception ex)
        {
            lblEstado.Text = "No se pudo cargar la información: " + ex.Message;
            lblEstado.ForeColor = Color.Firebrick;
        }
    }

    private void CargarGrafico(SqlConnection conexion)
    {
        var datos = new List<(string Mes, int Total)>();

        using var comando = new SqlCommand(@"
            SELECT
                FORMAT(DATEFROMPARTS(YEAR(FechaAtencion), MONTH(FechaAtencion), 1), 'MMM', 'es-PE') AS Mes,
                COUNT(*) AS Total
            FROM Atenciones
            WHERE Estado = 1
              AND FechaAtencion >= DATEADD(MONTH, -5,
                    DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))
              AND FechaAtencion < DATEADD(MONTH, 1,
                    DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))
            GROUP BY YEAR(FechaAtencion), MONTH(FechaAtencion)
            ORDER BY YEAR(FechaAtencion), MONTH(FechaAtencion);
        ", conexion);

        using var lector = comando.ExecuteReader();

        while (lector.Read())
        {
            datos.Add((
                Convert.ToString(lector["Mes"]) ?? "",
                Convert.ToInt32(lector["Total"])));
        }

        grafico.Datos = datos;
        grafico.Invalidate();
    }

    private void CargarAlertas(SqlConnection conexion)
    {
        listaAlertas.Controls.Clear();

        using var comando = new SqlCommand(@"
            SELECT TOP 8
                m.NombreMedicamento,
                i.StockActual,
                i.StockMinimo,
                i.FechaVencimiento,
                CASE
                    WHEN i.StockActual <= i.StockMinimo THEN 'Stock bajo'
                    ELSE 'Vencimiento próximo'
                END AS Motivo
            FROM Inventario i
            INNER JOIN Medicamentos m ON m.IdMedicamento = i.IdMedicamento
            WHERE m.Estado = 1
              AND (i.StockActual <= i.StockMinimo
                OR i.FechaVencimiento <= DATEADD(DAY, 30, CAST(GETDATE() AS date)))
            ORDER BY
                CASE WHEN i.StockActual <= i.StockMinimo THEN 0 ELSE 1 END,
                i.FechaVencimiento;
        ", conexion);

        using var lector = comando.ExecuteReader();
        bool hayDatos = false;

        while (lector.Read())
        {
            hayDatos = true;

            string nombre =
                Convert.ToString(lector["NombreMedicamento"]) ?? "Medicamento";

            string motivo = Convert.ToString(lector["Motivo"]) ?? "";
            string stock = "Stock: " + Convert.ToString(lector["StockActual"]);

            if (lector["FechaVencimiento"] != DBNull.Value)
            {
                stock += "  ·  Vence: " +
                    Convert.ToDateTime(lector["FechaVencimiento"])
                        .ToString("dd/MM/yyyy");
            }

            listaAlertas.Controls.Add(
                CrearFilaAlerta(nombre, motivo, stock));
        }

        if (!hayDatos)
            listaAlertas.Controls.Add(
                CrearMensaje("No hay alertas de farmacia."));

        AjustarAlertas();
    }

