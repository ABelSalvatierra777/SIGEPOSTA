    // ═══════════════════════ GRÁFICO DE ATENCIONES ═══════════════════════
    private class GraficoAtenciones : Panel
    {
        [System.ComponentModel.DesignerSerializationVisibility(
            System.ComponentModel.DesignerSerializationVisibility.Hidden)]
        public List<(string Mes, int Total)> Datos { get; set; } = new();

        public GraficoAtenciones()
        {
            SetStyle(
                ControlStyles.UserPaint |
                ControlStyles.AllPaintingInWmPaint |
                ControlStyles.OptimizedDoubleBuffer |
                ControlStyles.ResizeRedraw,
                true);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);

            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.TextRenderingHint = TextRenderingHint.ClearTypeGridFit;
            g.Clear(Color.White);

            if (Datos.Count == 0)
            {
                using var fuenteVacia = new Font("Segoe UI", 10);

                TextRenderer.DrawText(
                    g,
                    "Todavía no hay atenciones registradas.",
                    fuenteVacia,
                    ClientRectangle,
                    TemaSIGEPOSTA.TextoSecundario,
                    TextFormatFlags.HorizontalCenter |
                    TextFormatFlags.VerticalCenter);

                return;
            }

            int maximo = 1;

            foreach (var dato in Datos)
            {
                if (dato.Total > maximo)
                    maximo = dato.Total;
            }

            int paso = Math.Max(1, (int)Math.Ceiling(maximo / 4.0));
            int tope = paso * 4;

            int margenIzquierdo = 40;
            int margenDerecho = 12;
            int margenSuperior = 14;
            int margenInferior = 30;

            int anchoUtil = Math.Max(
                100, Width - margenIzquierdo - margenDerecho);

            int altoUtil = Math.Max(
                70, Height - margenSuperior - margenInferior);

            using var pincelTexto =
                new SolidBrush(TemaSIGEPOSTA.TextoSecundario);

            using var fuente = new Font("Segoe UI", 8);
            using var fuenteValor =
                new Font("Segoe UI", 8, FontStyle.Bold);

            using var linea = new Pen(TemaSIGEPOSTA.Borde);
            linea.DashStyle = DashStyle.Dash;

            for (int i = 0; i <= 4; i++)
            {
                int y = margenSuperior + altoUtil -
                    (altoUtil * i / 4);

                g.DrawLine(
                    linea,
                    margenIzquierdo,
                    y,
                    Width - margenDerecho,
                    y);

                string etiqueta = (paso * i).ToString();
                SizeF tam = g.MeasureString(etiqueta, fuente);

                g.DrawString(
                    etiqueta,
                    fuente,
                    pincelTexto,
                    margenIzquierdo - tam.Width - 6,
                    y - tam.Height / 2);
            }

            int ranura = anchoUtil / Datos.Count;

            int anchoBarra = Math.Max(
                14, Math.Min(56, (int)(ranura * 0.55)));

            for (int i = 0; i < Datos.Count; i++)
            {
                var dato = Datos[i];
                bool esUltimo = i == Datos.Count - 1;

                int x = margenIzquierdo +
                    i * ranura + (ranura - anchoBarra) / 2;

                int alto = (int)(
                    (double)dato.Total / tope * altoUtil);

                alto = dato.Total > 0 ? Math.Max(4, alto) : 2;

                int y = margenSuperior + altoUtil - alto;

                var rectangulo = new Rectangle(
                    x, y, anchoBarra, alto);

                Color c1 = esUltimo
                    ? Color.FromArgb(63, 150, 92)
                    : Color.FromArgb(150, 205, 170);

                Color c2 = esUltimo
                    ? TemaSIGEPOSTA.VerdeOscuro
                    : Color.FromArgb(105, 175, 134);

                using (GraphicsPath path =
                    RedondeadoSuperior(rectangulo, 6))
                using (var pincel = new LinearGradientBrush(
                    new Rectangle(x, y, anchoBarra, Math.Max(2, alto)),
                    c1, c2, 90f))
                {
                    g.FillPath(pincel, path);
                }

                string valor = dato.Total.ToString();
                SizeF tamValor = g.MeasureString(valor, fuenteValor);

                g.DrawString(
                    valor,
                    fuenteValor,
                    pincelTexto,
                    x + (anchoBarra - tamValor.Width) / 2,
                    y - 17);

                string mes =
                    char.ToUpper(dato.Mes.Length > 0 ? dato.Mes[0] : ' ') +
                    (dato.Mes.Length > 1
                        ? dato.Mes.Substring(1)
                        : "");

                SizeF tamMes = g.MeasureString(mes, fuente);

                g.DrawString(
                    mes,
                    fuente,
                    pincelTexto,
                    x + (anchoBarra - tamMes.Width) / 2,
                    margenSuperior + altoUtil + 7);
            }
        }
    }
