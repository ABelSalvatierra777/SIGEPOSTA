            Font = TemaSIGEPOSTA.Fuente,
            ForeColor = secundario,
            BackColor = Color.White,
            Padding = new Padding(8)
        };
    }

    // ═══════════════════════ CONTROLES PROPIOS ═══════════════════════

    private static GraphicsPath Redondeado(Rectangle r, int radio)
    {
        var path = new GraphicsPath();

        if (r.Width <= 0 || r.Height <= 0)
            return path;

        int d = Math.Min(radio * 2, Math.Min(r.Width, r.Height));

        path.AddArc(r.X, r.Y, d, d, 180, 90);
        path.AddArc(r.Right - d, r.Y, d, d, 270, 90);
        path.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
        path.AddArc(r.X, r.Bottom - d, d, d, 90, 90);
        path.CloseFigure();

        return path;
    }

    private static GraphicsPath RedondeadoSuperior(
        Rectangle r, int radio)
    {
        var path = new GraphicsPath();

        if (r.Width <= 0 || r.Height <= 0)
            return path;

        int d = Math.Min(radio * 2, Math.Min(r.Width, r.Height * 2));

        path.AddArc(r.X, r.Y, d, d, 180, 90);
        path.AddArc(r.Right - d, r.Y, d, d, 270, 90);
        path.AddLine(r.Right, r.Bottom, r.X, r.Bottom);
        path.CloseFigure();

        return path;
    }

    // ═══════════════════════ TARJETA REDONDEADA ═══════════════════════
    private class TarjetaRedondeada : Panel
    {
        [System.ComponentModel.DesignerSerializationVisibility(
            System.ComponentModel.DesignerSerializationVisibility.Hidden)]
        public Color FondoExterior { get; set; } =
            TemaSIGEPOSTA.Fondo;

        [System.ComponentModel.DesignerSerializationVisibility(
            System.ComponentModel.DesignerSerializationVisibility.Hidden)]
        public Color Acento { get; set; } = Color.Empty;

        public TarjetaRedondeada()
        {
            SetStyle(
                ControlStyles.UserPaint |
                ControlStyles.AllPaintingInWmPaint |
                ControlStyles.OptimizedDoubleBuffer |
                ControlStyles.ResizeRedraw,
                true);

            BackColor = Color.White;
        }

        public void AgregarContenido(Control contenido)
        {
            contenido.Dock = DockStyle.Fill;
            Controls.Add(contenido);
            contenido.BringToFront();
        }

        protected override void OnPaintBackground(PaintEventArgs e)
        {
            e.Graphics.Clear(FondoExterior);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);

            if (Width < 12 || Height < 12)
                return;

            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;

            Rectangle r = new Rectangle(1, 1, Width - 4, Height - 6);

            for (int i = 1; i <= 4; i++)
            {
                Rectangle s = new Rectangle(
                    r.X - 1, r.Y + i, r.Width + 2, r.Height);

                using (GraphicsPath p = Redondeado(s, 14))
                using (SolidBrush b = new SolidBrush(
                    Color.FromArgb(7, 20, 50, 35)))
                {
                    g.FillPath(b, p);
                }
            }

            using (GraphicsPath p = Redondeado(r, 14))
            {
                using (SolidBrush fondoTarjeta =
                    new SolidBrush(Color.White))
                {
                    g.FillPath(fondoTarjeta, p);
                }

                if (Acento != Color.Empty)
                {
                    GraphicsState estado = g.Save();
                    g.SetClip(p, CombineMode.Intersect);

                    using (SolidBrush b = new SolidBrush(Acento))
                    {
                        g.FillRectangle(
                            b, r.X, r.Y, 5, r.Height);
                    }

                    g.Restore(estado);
                }

                using (Pen borde = new Pen(TemaSIGEPOSTA.Borde, 1f))
                {
                    g.DrawPath(borde, p);
                }
            }
        }
    }

