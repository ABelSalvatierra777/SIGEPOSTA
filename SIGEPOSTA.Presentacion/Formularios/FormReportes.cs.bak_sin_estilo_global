                Dock = DockStyle.Fill,
                ReadOnly = true,
                AllowUserToAddRows = false,
                AllowUserToDeleteRows = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                BackgroundColor = TemaSIGEPOSTA.Blanco,
                RowHeadersVisible = false,
                AutoGenerateColumns = true,
                BorderStyle = BorderStyle.None,
                Margin = new Padding(5)
            };

            grupo.Controls.Add(dgvReporte);

            return grupo;
        }

        private Control CrearPie()
        {
            TableLayoutPanel pie = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 2,
                RowCount = 1,
                BackColor = TemaSIGEPOSTA.Fondo
            };

            pie.ColumnStyles.Add(
                new ColumnStyle(SizeType.Percent, 75));

            pie.ColumnStyles.Add(
                new ColumnStyle(SizeType.Percent, 25));

            lblResumen = new Label
            {
                Text = "Sin información para mostrar.",
                Dock = DockStyle.Fill,
                TextAlign = ContentAlignment.MiddleLeft,
                ForeColor = TemaSIGEPOSTA.VerdeOscuro,
                Font = TemaSIGEPOSTA.FuenteEtiqueta,
                Padding = new Padding(5)
