        private GroupBox CrearGrupoFiltros()
        {
            GroupBox grupo = new GroupBox
            {
                Text = "Filtros del reporte",
                Dock = DockStyle.Fill,
                Padding = new Padding(16, 12, 16, 12),
                BackColor = TemaSIGEPOSTA.Blanco,
                Margin = new Padding(0, 0, 0, 12)
            };

            TableLayoutPanel rejilla = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 6,
                RowCount = 2,
                BackColor = TemaSIGEPOSTA.Blanco,
                Padding = new Padding(5)
            };

            rejilla.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
            rejilla.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 40));
            rejilla.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
            rejilla.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 25));
            rejilla.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
            rejilla.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 35));

            rejilla.RowStyles.Add(new RowStyle(SizeType.Absolute, 45));
            rejilla.RowStyles.Add(new RowStyle(SizeType.Absolute, 55));

            cmbReporte = new ComboBox
            {
                DropDownStyle = ComboBoxStyle.DropDownList,
                Dock = DockStyle.Fill,
                Margin = new Padding(0, 6, 18, 6)
            };

            cmbReporte.Items.AddRange(new object[]
            {
                "Reporte de pacientes",
                "Reporte de personal de salud",
                "Reporte de citas médicas",
                "Reporte de atenciones médicas",
                "Reporte de diagnósticos",
                "Reporte de medicamentos",
                "Reporte de movimientos de inventario"
            });

            cmbReporte.SelectedIndex = 0;

            dtpDesde = new DateTimePicker
            {
                Format = DateTimePickerFormat.Short,
                Dock = DockStyle.Fill,
                Margin = new Padding(0, 6, 18, 6)
            };

            dtpHasta = new DateTimePicker
            {
                Format = DateTimePickerFormat.Short,
                Dock = DockStyle.Fill,
                Margin = new Padding(0, 6, 18, 6)
            };

            AgregarPar(rejilla, "Tipo de reporte:", cmbReporte, 0);
            AgregarPar(rejilla, "Desde:", dtpDesde, 2);
            AgregarPar(rejilla, "Hasta:", dtpHasta, 4);

            Button btnConsultar = NuevoBoton(
                "CONSULTAR", TipoBoton.Primario);

            btnConsultar.Click += (s, e) => Consultar();

            Button btnLimpiar = NuevoBoton(
                "LIMPIAR", TipoBoton.Secundario);

            btnLimpiar.Click += (s, e) => Limpiar();

            FlowLayoutPanel botones = new FlowLayoutPanel
            {
                Dock = DockStyle.Fill,
                FlowDirection = FlowDirection.LeftToRight,
                WrapContents = false,
                BackColor = TemaSIGEPOSTA.Blanco,
                Margin = new Padding(0, 5, 0, 0)
            };

            botones.Controls.Add(btnConsultar);
            botones.Controls.Add(btnLimpiar);

            Panel centrado = new Panel
            {
                Dock = DockStyle.Fill,
                BackColor = TemaSIGEPOSTA.Blanco
            };

            centrado.Controls.Add(botones);

            Action centrar = () =>
            {
                botones.Left = Math.Max(
                    0, (centrado.ClientSize.Width - botones.Width) / 2);
            };

            centrado.Resize += (s, e) => centrar();
            botones.SizeChanged += (s, e) => centrar();

            rejilla.Controls.Add(centrado, 0, 1);
            rejilla.SetColumnSpan(centrado, 6);

            grupo.Controls.Add(rejilla);

            return grupo;
        }

        private void AgregarPar(
            TableLayoutPanel rejilla,
            string texto,
            Control campo,
            int columna)
        {
            Label etiqueta = new Label
            {
                Text = texto,
                AutoSize = true,
                Anchor = AnchorStyles.Left,
                ForeColor = TemaSIGEPOSTA.Texto,
                Font = TemaSIGEPOSTA.FuenteEtiqueta,
                Margin = new Padding(0, 0, 10, 0)
            };

            rejilla.Controls.Add(etiqueta, columna, 0);
            rejilla.Controls.Add(campo, columna + 1, 0);
        }

        private GroupBox CrearGrupoResultados()
        {
